---
import Page from "../Page.astro";
import changelog from "../changelog.json";
const day = (iso: string) => new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---
<Page title="Changelog · OpenLeo" description="What's new in each version of OpenLeo." current="changelog">
<h1 class="text-[36px] leading-tight font-semibold tracking-[-0.03em]">Changelog</h1>
<p class="text-[13px] text-ink-3">What's new in each version. The app updates itself, or download the latest from <a href="https://github.com/ancs21/openleo/releases/latest">GitHub</a>.</p>
{changelog.releases.map((r) => <>
<h2>{r.version}</h2>
<p class="text-[13px] text-ink-3">{day(r.date)}</p>
<ul>{r.notes.map((n) => <li set:html={n} />)}</ul>
</>)}
<p class="mt-8 flex flex-wrap gap-4 border-t border-dashed border-line pt-6 text-[13px] text-ink-3"><a href="./">Home</a><a href="./download">Download</a><a href="./blog">Blog</a><a href="./changelog">Changelog</a><a href="./privacy">Privacy</a><a href="./terms">Terms</a></p>
</Page>
