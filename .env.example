# Copy to .env and set what you need. Everything is optional; the defaults are shown.

# Where data lives
# OPENLEO_HOME=data

# Where computers run: apple (native, macOS 26+), local (Docker) or cloud. Unset: apple when this Mac can, else Docker
# OPENLEO_SANDBOX_ON=
# Computer image (Docker): OpenLeo's own, which the app's setup downloads (or build it: `bun run computer:build`)
# OPENLEO_SANDBOX_IMAGE=openleo-computer
# Image and DNS when OPENLEO_SANDBOX_ON=apple
# OPENLEO_APPLE_IMAGE=openleo-computer
# OPENLEO_APPLE_DNS=1.1.1.1
# off runs tools on this machine (then only the owner can sign in)
# OPENLEO_SANDBOX=on

# Limits per account (the owner has none)
# OPENLEO_MAX_BOARDS=3
# OPENLEO_MAX_RUNS=3
# OPENLEO_MAX_STORAGE_MB=1024

# Size of each computer
# OPENLEO_COMPUTER_CPUS=2
# OPENLEO_COMPUTER_MEMORY_MB=4096

# Search all of Unsplash for board wallpapers (https://unsplash.com/developers). Without it: 100 built-in photos
# UNSPLASH_ACCESS_KEY=
